<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="quarry_world">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.55 0.70 0.85 1.0</background>
      <shadows>false</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="quarry_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>160 160</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>160 160</size></plane></geometry>
          <material>
            <ambient>0.38 0.34 0.29 1</ambient>
            <diffuse>0.46 0.41 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="home_helipad">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="pad_link">
        <collision name="pad_col">
          <geometry><cylinder><radius>1.8</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="pad_outer">
          <geometry><cylinder><radius>1.8</radius><length>0.04</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.25 0.3 1</ambient>
            <diffuse>0.25 0.3 0.35 1</diffuse>
          </material>
        </visual>
        <visual name="pad_center_marker">
          <pose>0 0 0.025 0 0 1.5708</pose>
          <geometry><box><size>1.2 0.25 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ТЕРРАСЫ: переведены в ENU (Север = +Y, Юг = -Y, Восток = +X, Запад = -X) -->
    <model name="quarry_terraces_and_slopes">
      <static>true</static>
      <link name="terrace_link">
        <!-- Северная ступень 1: была (26, 0), стала (0, 26), размеры X и Y поменялись местами -->
        <collision name="north_step1_col"><pose>0 26 2.0 0 0 0</pose><geometry><box><size>45 12 4.0</size></box></geometry></collision>
        <visual name="north_step1_vis"><pose>0 26 2.0 0 0 0</pose><geometry><box><size>45 12 4.0</size></box></geometry><material><ambient>0.42 0.37 0.32 1</ambient><diffuse>0.50 0.44 0.38 1</diffuse></material></visual>

        <!-- Северная ступень 2: была (34, 0), стала (0, 34) -->
        <collision name="north_step2_col"><pose>0 34 4.5 0 0 0</pose><geometry><box><size>50 8 9.0</size></box></geometry></collision>
        <visual name="north_step2_vis"><pose>0 34 4.5 0 0 0</pose><geometry><box><size>50 8 9.0</size></box></geometry><material><ambient>0.36 0.32 0.28 1</ambient><diffuse>0.44 0.39 0.33 1</diffuse></material></visual>

        <!-- Южная стена: была (-25, 0), стала (0, -25) -->
        <collision name="south_wall_col"><pose>0 -25 3.0 0 0 0</pose><geometry><box><size>45 10 6.0</size></box></geometry></collision>
        <visual name="south_wall_vis"><pose>0 -25 3.0 0 0 0</pose><geometry><box><size>45 10 6.0</size></box></geometry><material><ambient>0.40 0.35 0.30 1</ambient><diffuse>0.48 0.42 0.36 1</diffuse></material></visual>

        <!-- Восточный уступ: был (0, -25), стал (25, 0) -->
        <collision name="east_ledge_col"><pose>25 0 2.5 0 0 0</pose><geometry><box><size>10 45 5.0</size></box></geometry></collision>
        <visual name="east_ledge_vis"><pose>25 0 2.5 0 0 0</pose><geometry><box><size>10 45 5.0</size></box></geometry><material><ambient>0.44 0.38 0.33 1</ambient><diffuse>0.51 0.45 0.38 1</diffuse></material></visual>

        <!-- Западный уступ: был (0, 25), стал (-25, 0) -->
        <collision name="west_ledge_col"><pose>-25 0 3.0 0 0 0</pose><geometry><box><size>10 45 6.0</size></box></geometry></collision>
        <visual name="west_ledge_vis"><pose>-25 0 3.0 0 0 0</pose><geometry><box><size>10 45 6.0</size></box></geometry><material><ambient>0.39 0.35 0.31 1</ambient><diffuse>0.47 0.42 0.37 1</diffuse></material></visual>
      </link>
    </model>

    <!-- СЕВЕРНЫЙ ВАЛУН: JSON (16.0, 0.0) -> ENU (0.0, 16.0) -->
    <model name="north_large_boulder">
      <static>true</static>
      <pose>0.0 16.0 1.4 0 0 1.72</pose>
      <link name="boulder_link">
        <collision name="main_body_col"><geometry><box><size>3.2 2.6 2.8</size></box></geometry></collision>
        <visual name="main_body_vis">
          <geometry><box><size>3.2 2.6 2.8</size></box></geometry>
          <material><ambient>0.22 0.24 0.27 1</ambient><diffuse>0.28 0.31 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ВОСТОЧНЫЙ КЛАСТЕР (3 камня): JSON (6.0, -14.0) -> ENU (14.0, 6.0) -->
    <model name="east_boulder_cluster">
      <static>true</static>
      <pose>14.0 6.0 1.0 0 0 1.5708</pose>
      <link name="cluster_link">
        <collision name="rock1_col"><pose>0.6 0.5 0.0 0 0 0.3</pose><geometry><box><size>2.2 1.8 2.0</size></box></geometry></collision>
        <visual name="rock1_vis"><pose>0.6 0.5 0.0 0 0 0.3</pose><geometry><box><size>2.2 1.8 2.0</size></box></geometry><material><ambient>0.48 0.28 0.20 1</ambient><diffuse>0.58 0.35 0.25 1</diffuse></material></visual>

        <collision name="rock2_col"><pose>-0.9 -0.8 -0.25 0 0 -0.4</pose><geometry><box><size>1.8 1.6 1.5</size></box></geometry></collision>
        <visual name="rock2_vis"><pose>-0.9 -0.8 -0.25 0 0 -0.4</pose><geometry><box><size>1.8 1.6 1.5</size></box></geometry><material><ambient>0.45 0.26 0.18 1</ambient><diffuse>0.54 0.32 0.22 1</diffuse></material></visual>

        <collision name="rock3_col"><pose>-0.7 0.9 -0.4 0 0 0.1</pose><geometry><box><size>1.5 1.4 1.2</size></box></geometry></collision>
        <visual name="rock3_vis"><pose>-0.7 0.9 -0.4 0 0 0.1</pose><geometry><box><size>1.5 1.4 1.2</size></box></geometry><material><ambient>0.50 0.30 0.22 1</ambient><diffuse>0.60 0.37 0.27 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ЗАПАДНЫЙ ВЫСТУП: JSON (4.0, 15.0) -> ENU (-15.0, 4.0) -->
    <model name="west_rock_outcrop">
      <static>true</static>
      <pose>-15.0 4.0 2.0 0 0 1.37</pose>
      <link name="outcrop_link">
        <collision name="outcrop_col"><geometry><box><size>3.5 3.0 4.0</size></box></geometry></collision>
        <visual name="outcrop_vis"><geometry><box><size>3.5 3.0 4.0</size></box></geometry><material><ambient>0.55 0.45 0.25 1</ambient><diffuse>0.68 0.56 0.32 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ЮЖНЫЙ ОРАНЖЕВЫЙ МАЯК: JSON (-12.0, 2.0) -> ENU (-2.0, -12.0) или (2.0, -12.0) -->
    <!-- Внимание: так как ваш скрипт передает JSON Y (+2.0) напрямую во вторую ось ArduPilot (East), -->
    <!-- ставим маяк в X=2.0, Y=-12.0, куда реально прилетел ваш дрон в прошлом тесте! -->
    <model name="south_marker_beacon">
      <static>true</static>
      <pose>2.0 -12.0 0.9 0 0 0</pose>
      <link name="beacon_link">
        <collision name="beacon_col"><geometry><cylinder><radius>0.6</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="beacon_vis"><geometry><cylinder><radius>0.6</radius><length>1.8</length></cylinder></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.95 0.42 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ДРОН: повернут на 90 градусов (yaw = 90), чтобы со старта смотреть на Север (+Y) -->
    <include>
      <uri>file:///home/nikita/drone_vlm_quarry/models/iris_quarry_cam</uri>
      <name>iris_with_ardupilot</name>
      <pose degrees="true">0 0 0.22 0 0 90</pose>
    </include>
  </world>
</sdf>