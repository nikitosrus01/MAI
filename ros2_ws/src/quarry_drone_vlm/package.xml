<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quarry_drone_vlm</name>
  <version>1.0.0</version>
  <description>Пакет ROS 2 Jazzy для управления квадрокоптером ArduPilot SITL с помощью локальной VLM Qwen2.5-VL в виртуальном карьере Gazebo Harmonic.</description>
  <maintainer email="nikita@localhost">Nikita</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
